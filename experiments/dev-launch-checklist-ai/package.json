{
  "name": "dev-launch-checklist-ai",
  "version": "0.1.0",
  "description": "Generate a 10-minute project readiness report from a local repository.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "dev-launch-checklist-ai": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node ./src/cli.mjs",
    "report:sample": "node ./src/cli.mjs /home/runner/work/rea/rea --fix-suggestions --output ./samples/sample-report.md",
    "smoke": "node ./src/cli.mjs . --fix-suggestions --output ./samples/ci-report.md"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "readiness",
    "audit",
    "checklist",
    "cli",
    "developer-tools"
  ]
}
